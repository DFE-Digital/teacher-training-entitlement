<% if course.present? || captured_values.any? %>
  <%= helpers.govuk_summary_list do |summary_list| %>
    <% if course.present? %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: "Course") %>
        <% row.with_value(text: course.name) %>
        <% unless Rails.env.production? %>
          <% row.with_action(text: "Change", href: step_registration_path(Registrations::Journeys::CourseSelectionWizard::JOURNEY_SLUG, Registrations::Journeys::CourseSelectionWizard::COURSES_STEP)) %>
        <% end %>
      <% end %>
    <% end %>

    <% answer_rows.each do |key, value, step_definition| %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: answer_label(key:, step_definition:)) %>
        <% row.with_value { display_value(step_definition:, value:) } %>
        <% if step_definition %>
          <% row.with_action(text: "Change", href: change_path(step_definition)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p class="govuk-body">No answers have been captured yet.</p>
<% end %>
