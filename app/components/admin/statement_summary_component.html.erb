<div class="govuk-summary-card">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">Statement summary</h2>
    <div class="govuk-grid-column-one-half govuk-!-text-align-right">
      <p class="govuk-!-static-margin-1">
        <strong>
          <%= helpers.govuk_link_to "Download declarations (CSV)", admin_finance_assurance_report_path(statement, format: :csv) %>
        </strong>
      </p>
    </div>
  </div>
  <div class="govuk-summary-card__content">
    <h3 class="govuk-heading-s">Funded declarations</h3>

    <%= helpers.govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(text: "Declaration type")
          row.with_cell(text: "Expected", numeric: true)
          row.with_cell(text: "Received", numeric: true)
          row.with_cell(text: "Outstanding", numeric: true)
        end
      end

      table.with_body do |body|
        body.with_row do |row|
          row.with_cell(text: "Starts")
          row.with_cell(text: expected_starts, numeric: true)
          row.with_cell(text: total_starts, numeric: true)
          row.with_cell(text: outstanding_starts, numeric: true)
        end

        body.with_row do |row|
          row.with_cell(text: "Completed")
          row.with_cell(text: expected_completed, numeric: true)
          row.with_cell(text: total_completed, numeric: true)
          row.with_cell(text: outstanding_completed, numeric: true)
        end

        body.with_row do |row|
          row.with_cell(text: tag.strong("Total"))
          row.with_cell(text: tag.strong(expected_total), numeric: true)
          row.with_cell(text: tag.strong(total_declarations), numeric: true)
          row.with_cell(text: tag.strong(outstanding_total), numeric: true)
        end
      end
    end %>

    <h3 class="govuk-heading-s">Payment details</h3>

    <%= helpers.govuk_summary_list do |summary_list|
      summary_list.with_row do |row|
        row.with_key { "Expected output payment" }
        row.with_value { number_to_currency(expected_output_payment) }
      end

      summary_list.with_row do |row|
        row.with_key { label_with_hint("Output payment", "This payment takes into account late declarations and voids") }
        row.with_value { number_to_currency(total_output_payment) }
      end

      summary_list.with_row do |row|
        row.with_key { "Declaration deadline" }
        row.with_value { statement.deadline_date.to_fs(:govuk) }
        row.with_action(text: "Change", href: admin_finance_statements_change_deadline_date_path(statement))
      end

      summary_list.with_row do |row|
        row.with_key { "Voids" }
        row.with_value { total_voided.to_s }
        row.with_action(text: "View Voids", href: admin_finance_voided_index_path(statement)) if link_to_voids
      end

      summary_list.with_row do |row|
        row.with_key { label_with_hint("Clawbacks", "The total value of voids") }
        row.with_value { number_to_currency(-total_clawbacks) }
      end

      summary_list.with_row do |row|
        row.with_key { "Manual adjustments" }
        row.with_value { number_to_currency(total_adjustments) }
      end

      unless total_service_fees.zero?
        summary_list.with_row do |row|
          row.with_key { "Service fee" }
          row.with_value { number_to_currency(total_service_fees) }
        end
      end

      summary_list.with_row do |row|
        row.with_key { "Total net VAT" }
        row.with_value { tag.strong number_to_currency(total_payment) }
      end
    end %>
  </div>
</div>
