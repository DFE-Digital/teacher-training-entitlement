<%=
govuk_table do |table|
  table.with_head do |head|
    head.with_row do |row|
      row.with_cell(text: "Course")
      row.with_cell(text: "Recruitment target")
      row.with_cell(text: "Teacher funding")
    end
  end

  table.with_body do |body|
    @course_cohorts.each do |course_cohort|
      computed = ComputedContract.draw(lead_provider: @statement.lead_provider, course_cohort:)
      body.with_row do |row|
        row.with_cell(text: course_cohort.course.name)
        row.with_cell(text: computed.recruitment_target)
        row.with_cell(text: number_to_currency(computed.teacher_funding))
      end
    end
  end
end
%>
