<%=
govuk_table do |table|
  table.with_head do |head|
    head.with_row do |row|
      row.with_cell(text: "Course")
      row.with_cell(text: "Recruitment target this cohort")
      row.with_cell(text: "Payment per participant")
    end
  end

  table.with_body do |body|
    @course_cohorts.each do |course_cohort|
      computed_contract = @statement.lead_provider.contract(course_cohort:)
      body.with_row do |row|
        row.with_cell(text: course_cohort.course.name)
        row.with_cell(text: computed_contract.recruitment_target)
        row.with_cell(text: number_to_currency(computed_contract.teacher_funding))
      end
    end
  end
end
%>
