<% content_for :side_navigation do %>
  <%= render CohortsComponent.new(
        request.path,
        course_cohorts: @course_cohorts,
        base_path: :admin_finance_statements_path,
        current_academic_year: @current_academic_year,
    ) %>
<% end %>

<h1 class="govuk-heading-l">Finance</h1>
<p class="govuk-body">You can search for financial statements that are paid or unpaid.</p>

<div class="admin-search-box">
  <%= render Admin::StatementSelectorComponent.new(params, cohort: @current_cohort, academic_year: @current_academic_year) %>
</div>

<%= render Admin::StatementsTableComponent.new(@statements) %>

<%= govuk_pagination(pagy: @pagy) %>
