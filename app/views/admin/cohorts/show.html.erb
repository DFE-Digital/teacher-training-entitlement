<h1 class="govuk-heading-l">Cohort <%= @cohort.description %></h1>

<%=
  govuk_summary_list do |sl|
    sl.with_row do |row|
      row.with_key(text: "Name")
      row.with_value(text: @cohort.name)
    end

    sl.with_row do |row|
      row.with_key(text: "Start year")
      row.with_value(text: @cohort.start_year)
    end

    sl.with_row do |row|
      row.with_key(text: "Registration start date")
      row.with_value(text: @cohort.registration_starts_at.to_date.to_fs(:govuk))
    end

    sl.with_row do |row|
      row.with_key(text: "Funding cap")
      row.with_value(text: boolean_red_green_tag(@cohort.funding_cap))
    end
  end
%>

<% if current_admin.super_admin? %>
  <%= govuk_button_link_to("Edit cohort details", edit_admin_cohort_path(@cohort)) %>
  <%= govuk_button_link_to("Delete cohort", admin_cohort_path(@cohort), method: :delete, warning: true) %>
<% end %>

<hr class="govuk-section-break govuk-section-break--l">

<h2 class="govuk-heading-m">Courses</h2>

<% if current_admin.super_admin? %>
  <%= govuk_button_link_to("Add course", new_admin_cohort_course_path(@cohort)) %>
<% end %>

<%
  course_cohorts_by_course = @cohort
    .course_cohorts
    .includes(:course)
    .sort_by { |course_cohort| [course_cohort.course.name, course_cohort.training_starts_at || Date.new(9999, 12, 31)] }
    .group_by(&:course)
%>

<%=
  govuk_table do |table|
    table.with_head do |head|
      head.with_row do |row|
        row.with_cell(text: "Course")
        row.with_cell(text: "Training start date")
        row.with_cell(text: "Training end date")
      end
    end

    table.with_body do |body|
      course_cohorts_by_course.each do |course, course_cohorts|
        course_cohorts.each_with_index do |course_cohort, index|
          body.with_row do |row|
            row.with_cell(text: index.zero? ? govuk_link_to(course.name, admin_cohort_course_path(@cohort, course)) : "")
            row.with_cell(text: course_cohort.training_starts_at&.to_fs(:govuk) || "-")
            row.with_cell(text: course_cohort.training_ends_at&.to_fs(:govuk) || "-")
          end
        end
      end
    end
  end
%>
