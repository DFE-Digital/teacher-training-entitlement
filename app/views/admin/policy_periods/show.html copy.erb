<h1 class="govuk-heading-l">Policy period <%= @policy_period.name %></h1>

<%=
  govuk_summary_list do |summary_list|
    summary_list.with_row do |row|
      row.with_key(text: "Name")
      row.with_value(text: @policy_period.name)
    end

    summary_list.with_row do |row|
      row.with_key(text: "Start date")
      row.with_value(text: @policy_period.start_date.to_fs(:govuk))
    end

    summary_list.with_row do |row|
      row.with_key(text: "End date")
      row.with_value(text: @policy_period.end_date.to_fs(:govuk))
    end
  end
%>

<h2 class="govuk-heading-m">Course cohorts and milestones</h2>

<% @course_cohorts.each do |course, course_cohorts| %>
  <h3 class="govuk-heading-s"><%= course.name %></h3>

  <% course_cohorts.each do |course_cohort| %>
    <div class="govuk-summary-card">
      <div class="govuk-summary-card__title-wrapper">
        <div class="govuk-summary-card__title">
          <h4>
            <%= course.name %>
            /
            <%= course_cohort.cohort.description %>
          </h4>

          <h5>
            <%= course_cohort.training_starts_at&.to_fs(:govuk) || '-'%>
            to 
            <%=course_cohort.training_ends_at&.to_fs(:govuk) || '-' %>
          </h5>
        </div>
      </div>

      <div class="govuk-summary-card__content">
        <%=
          govuk_summary_list do |summary_list|
            summary_list.with_row do |row|
              row.with_key(text: "Registration")
              row.with_value(text: "#{course_cohort.registration_starts_at&.to_fs(:govuk) || '-'} to #{course_cohort.registration_ends_at&.to_fs(:govuk) || '-'}")
            end

            summary_list.with_row do |row|
              row.with_key(text: "Training")
              row.with_value(text: "#{course_cohort.training_starts_at&.to_fs(:govuk) || '-'} to #{course_cohort.training_ends_at&.to_fs(:govuk) || '-'}")
            end

            summary_list.with_row do |row|
              row.with_key(text: "Participant funding")
              row.with_value(text: course_cohort.participant_funding ? number_to_currency(course_cohort.participant_funding) : "-")
            end

            summary_list.with_row do |row|
              row.with_key(text: "Service fee")
              row.with_value(text: course_cohort.service_fee ? number_to_currency(course_cohort.service_fee) : "-")
            end
          end
        %>

        <h5 class="govuk-heading-s">Milestones</h5>

        <% if course_cohort.milestones.any? %>
          <%=
            govuk_table do |table|
              table.with_head do |head|
                head.with_row do |row|
                  row.with_cell(text: "Declaration")
                  row.with_cell(text: "Acceptance window")
                  row.with_cell(text: "Statement month")
                  row.with_cell(text: "Payment amount", numeric: true)
                end
              end

              table.with_body do |body|
                course_cohort.milestones.each do |milestone|
                  body.with_row do |row|
                    row.with_cell(text: milestone.declaration_type.humanize)
                    row.with_cell(text: "#{milestone.acceptance_window_start_date&.to_fs(:govuk) || '-'} to #{milestone.acceptance_window_end_date&.to_fs(:govuk) || '-'}")
                    row.with_cell(text: milestone.statement_date&.to_fs(:govuk_approx) || "-")
                    row.with_cell(text: milestone.payment_amount ? number_to_currency(milestone.payment_amount) : "-", numeric: true)
                  end
                end
              end
            end
          %>
        <% else %>
          <p class="govuk-body">No milestones have been added.</p>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
