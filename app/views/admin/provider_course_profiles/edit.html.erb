<%= govuk_back_link href: admin_lead_provider_path(@lead_provider) %>

<h1 class="govuk-heading-l">Edit provider course profile</h1>

<%= form_with model: @provider_course_profile, url: admin_lead_provider_provider_course_profile_path(@lead_provider, @course), method: :patch do |form| %>
  <%= form.govuk_error_summary %>

  <%=
    govuk_summary_list do |summary_list|
      summary_list.with_row do |row|
        row.with_key(text: "Provider")
        row.with_value(text: @lead_provider.name)
      end

      summary_list.with_row do |row|
        row.with_key(text: "Course")
        row.with_value(text: @course.name)
      end
    end
  %>

  <%=
    form.govuk_text_field :url,
                          width: "two-thirds",
                          label: {
                            text: "Website URL",
                            size: "m",
                          }
  %>

  <div class="govuk-button-group">
    <%= form.govuk_submit "Save profile" %>
    <%= govuk_link_to "Cancel", admin_lead_provider_path(@lead_provider), class: "govuk-link--no-visited-state" %>
  </div>
<% end %>
