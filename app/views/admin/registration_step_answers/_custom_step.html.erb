<%= form_with url: admin_registration_journey_registration_step_custom_step_path(registration_step.registration_journey, registration_step), multipart: true do |form| %>
  <%=
    form.govuk_collection_select(
      :custom_step,
      registration_step.custom_steps,
      :to_s,
      :to_s,
      options: { prompt: true, selected: registration_step.custom_step_class_name },
      label: {
        text: "Custom step",
        size: "m",
      },
      hint: {
        text: "To add a step create a class located under `app/wizards/forms` which inherits from Forms::CustomRegistrationStepForm",
      },
    )
  %>

  <%=
    form.govuk_collection_select(
      :next_step_id,
      registration_step.other_registration_steps,
      :id,
      :name,
      options: { include_blank: "Default next step" },
      label: {
        text: "Next step",
        size: "m",
      },
    )
  %>

  <%= form.govuk_submit registration_step.custom_step_class_name.blank? ? "Add" : "Update" %>
<% end %>
