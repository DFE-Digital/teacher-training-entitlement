<%= govuk_back_link href: admin_cohort_path(@cohort) %>

<h1 class="govuk-heading-l">Add course to cohort <%= @cohort.description %></h1>

<%= form_with model: @course_cohort, url: admin_cohort_courses_path(@cohort) do |f| %>
  <%= f.govuk_error_summary %>
  <%=
    f.govuk_collection_select(
      :course_id,
      @courses,
      :id,
      :name,
      options: { include_blank: true },
      label: { text: "Course" },
    )
  %>

  <%= f.govuk_date_field :registration_starts_at, legend: { text: "Registration starts at" } %>
  <%= f.govuk_date_field :registration_ends_at, legend: { text: "Registration ends at" } %>
  <%= f.govuk_date_field :training_starts_at, legend: { text: "Training starts at" } %>
  <%= f.govuk_date_field :training_ends_at, legend: { text: "Training ends at" } %>

  <%= f.govuk_submit "Add course" %>
<% end %>
