<% content_for :side_navigation do %>
  <%= render RegistrationPeriodsComponent.new(
    request.path,
    base_path: :admin_courses_path,
    current_academic_year: @current_academic_year,
  ) %>
<% end %>

<h1 class="govuk-heading-l">Courses</h1>
<%= govuk_button_link_to("Create course", "/admin/course-builder") %>
<%=
govuk_table do |table|
  table.with_head do |header|
    header.with_row do |row|
      row.with_cell(text: "Name")
      row.with_cell(text: "Nb applications")
    end
  end

  table.with_body do |body|
    @resources.each do |course|
      body.with_row do |row|
        row.with_cell do
          if @current_cohort
            govuk_link_to(course.name, cohort_admin_course_path(course, @current_cohort))
          else
            course.name
          end
        end
        row.with_cell(text: course.applications.size)
      end
    end
  end
end
%>

<%= govuk_pagination(pagy: @pagy) %>

<% if using_default_academic_year? && @unassigned_courses.any? %>
  <h2 class="govuk-heading-m">Courses not assigned to a cohort</h2>

  <%=
    govuk_table do |table|
      table.with_head do |header|
        header.with_row do |row|
          row.with_cell(text: "Name")
          row.with_cell(text: "Identifier")
          row.with_cell(text: "Action")
        end
      end

      table.with_body do |body|
        @unassigned_courses.each do |course|
          body.with_row do |row|
            row.with_cell { govuk_link_to(course.name, admin_course_path(course)) }
            row.with_cell(text: course.identifier)
            row.with_cell { govuk_button_link_to("Add registration period", "/admin/cohorts", secondary: true) }
          end
        end
      end
    end
  %>
<% end %>
