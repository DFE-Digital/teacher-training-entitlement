<% content_for :side_navigation do %>
  <%= render CohortsComponent.new(
        request.path,
        cohorts: @cohorts,
        base_path: :admin_courses_path,
    ) %>
<% end %>

<h1 class="govuk-heading-l">Courses</h1>

<% if current_admin.super_admin? %>
  <%= govuk_link_to "Create course", new_admin_course_path, class: "govuk-button" %>
<% end %>

<%=
govuk_table do |table|
    table.with_head do |header|
        header.with_row do |row|
            row.with_cell(text: "Name")
            row.with_cell(text: "Nb applications")
        end
    end

    table.with_body do |body|
        @resources.each do |course|
            body.with_row do |row|
                row.with_cell do
                  govuk_link_to(course.name, admin_course_path(course))
                end
                row.with_cell(text: course.applications.size)
            end
        end
    end
end
%>

<%= govuk_pagination(pagy: @pagy) %>
