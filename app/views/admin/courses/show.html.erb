<%= govuk_back_link href: request.referrer.presence || admin_courses_path %>

<h1 class="govuk-heading-l"><%= @course.name %></h1>

<% if current_admin.super_admin? %>
  <%= govuk_button_link_to("Edit course details", edit_admin_course_path(@course)) %>
<% end %>

<%=
govuk_summary_list do |summary_list|
  summary_list.with_row do |row|
    row.with_key(text: "Course ID")
    row.with_value(text: @course.ecf_id)
  end

  summary_list.with_row do |row|
    row.with_key(text: "Identifier")
    row.with_value(text: @course.identifier)
  end

  summary_list.with_row do |row|
    row.with_key(text: "Short code")
    row.with_value(text: @course.short_code)
  end

  summary_list.with_row do |row|
    row.with_key(text: "Group")
    row.with_value(text: @course.course_group)
  end

  summary_list.with_row do |row|
    row.with_key(text: "Description")
    row.with_value(text: @course.description)
  end
end
%>

<h2 class="govuk-heading-m">Milestones</h2>

<% if @course.milestones.any? %>
  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(text: "Declaration type")
          row.with_cell(text: "Offset window start")
          row.with_cell(text: "Offset window end")
          row.with_cell(text: "Payment percentage")
        end
      end

      table.with_body do |body|
        @course.milestones.each do |milestone|
          body.with_row do |row|
            row.with_cell(text: milestone.declaration_type)
            row.with_cell(text: acceptance_window_start_date&.to_fs(:govuk) || "-")
            row.with_cell(text: acceptance_window_end_date&.to_fs(:govuk) || "-")
            row.with_cell(text: milestone.payment_percentage ? number_to_percentage(milestone.payment_percentage * 100, precision: 2, strip_insignificant_zeros: true) : "-")
          end
        end
      end
    end
  %>
<% else %>
  <p class="govuk-body">No milestones have been added.</p>
<% end %>

<h2 class="govuk-heading-m">Contract financials & targets</h2>

<% contract_financials = @contract_years.select { |contract_year| contract_year.teacher_funding.present? || contract_year.recruitment_target.present? || contract_year.service_fee.present? } %>
<% if contract_financials.any? %>
  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(text: "Lead provider")
          row.with_cell(text: "Academic year")
          row.with_cell(text: "Teacher funding")
          row.with_cell(text: "Recruitment target")
          row.with_cell(text: "Service fee")
        end
      end

      table.with_body do |body|
        contract_financials.each do |contract_year|
          body.with_row do |row|
            row.with_cell(text: contract_year.lead_provider.name)
            row.with_cell(text: contract_year.academic_year || "Generic")
            row.with_cell(text: contract_year.teacher_funding ? number_to_currency(contract_year.teacher_funding, unit: "£") : "-")
            row.with_cell(text: contract_year.recruitment_target ? number_with_delimiter(contract_year.recruitment_target) : "-")
            row.with_cell(text: contract_year.service_fee ? number_to_currency(contract_year.service_fee, unit: "£") : "-")
          end
        end
      end
    end
  %>
<% else %>
  <p class="govuk-body">No contract years have been added.</p>
<% end %>

<h2 class="govuk-heading-m">Contract year contact details</h2>

<% contact_contract_years = @contract_years.select { |contract_year| contract_year.course_url.present? || contract_year.email.present? } %>
<% if contact_contract_years.any? %>
  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(text: "Lead provider")
          row.with_cell(text: "Academic year")
          row.with_cell(text: "Course URL")
          row.with_cell(text: "Email")
        end
      end

      table.with_body do |body|
        contact_contract_years.each do |contract_year|
          body.with_row do |row|
            row.with_cell(text: contract_year.lead_provider.name)
            row.with_cell(text: contract_year.academic_year || "Generic")
            row.with_cell do
              if contract_year.course_url.present?
                govuk_link_to(contract_year.course_url, contract_year.course_url)
              else
                "-"
              end
            end
            row.with_cell(text: contract_year.email.presence || "-")
          end
        end
      end
    end
  %>
<% else %>
  <p class="govuk-body">No contract year contact details have been added.</p>
<% end %>
