<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    <h1 class="govuk-heading-l">Courses</h1>

    <%= govuk_button_link_to("Add new course", admin_settings_courses_builder_path("course-details")) %>

    <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(header: true, text: "Name")
          row.with_cell(header: true, text: "Group")
        end
      end

      table.with_body do |body|
        @courses.each do |course|
          body.with_row do |row|
            row.with_cell(text: govuk_link_to(course.name, admin_settings_course_path(course)))
            row.with_cell(text: course.course_group)
          end
        end
      end
    end
    %>

    <%== govuk_pagination(pagy: @pagy) %>
  </div>
</div>
