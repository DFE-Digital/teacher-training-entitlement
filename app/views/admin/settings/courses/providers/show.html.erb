<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <%= govuk_back_link href: admin_settings_course_path(@course) %>

    <h1 class="govuk-heading-l"><%= @lead_provider.name %> contract details</h1>

    <%=
    govuk_summary_list(card: { title: "Overview"}) do |sl|
      sl.with_row do |row|
        row.with_key(text: "Lead provider name")
        row.with_value(text: @lead_provider.name)
      end
      sl.with_row do |row|
        row.with_key(text: "Course name")
        row.with_value(text: @course.name)
      end

      %i[course_url email].each do |key|
        sl.with_row do |row|
          row.with_key(text: t(".#{key}"))
          row.with_value(text: @contract_generic&.public_send(key).presence || "-")
        end
      end
    end
    %>

    <h2 class="govuk-heading-m">Contract details</h2>

    <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(text: "Academic year")
          row.with_cell(text: "Recruitment target")
          row.with_cell(text: "Teacher funding")
        end
      end

      table.with_body do |body|
        @contract_years.each do |contract_year|
          body.with_row do |row|
            row.with_cell(text: contract_year.academic_year)
            row.with_cell(text: contract_year.recruitment_target)
            row.with_cell(text: number_to_currency(contract_year.teacher_funding, unit: "£"))
          end
        end
      end
    end
    %>

    <h2 class="govuk-heading-m">Delivery partners</h2>

    <% if @delivery_partnerships.any? %>
      <ul class="govuk-list govuk-list--bullet">
        <% @delivery_partnerships.each do |partnership| %>
          <li><%= partnership.delivery_partner.name %></li>
        <% end %>
      </ul>
      <%= govuk_pagination(pagy: @pagy_delivery_partnerships) %>
    <% else %>
      <p class="govuk-body">No delivery partners.</p>
    <% end %>
  </div>
  </div>
