<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    <h1 class="govuk-heading-l">Lead providers</h1>

    <%= govuk_button_link_to("Add new lead provider", new_admin_settings_lead_provider_path) %>

    <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(header: true, text: "Name")
          row.with_cell(header: true, text: "Active")
        end
      end

      table.with_body do |body|
        @lead_providers.each do |h|
          lead_provider, active, seed = h.values_at(:lead_provider, :active, :seed)
          body.with_row do |row|
            row.with_cell(text: govuk_link_to(lead_provider.name, admin_settings_lead_provider_path(lead_provider)))
            if active
              row.with_cell(text: govuk_tag(text: "active", colour: "green"))
            else
              row.with_cell(text: govuk_tag(text: "inactive", colour: "red"))
            end
          end
        end
      end
    end
    %>

    <%== govuk_pagination(pagy: @pagy) %>
  </div>
</div>
