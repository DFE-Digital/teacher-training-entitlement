<%= govuk_back_link href: admin_course_cohort_path(@course, @course_cohort.cohort_id) %>

<h1 class="govuk-heading-l">Add or remove providers</h1>

<%=
govuk_summary_list do |sl|
  sl.with_row do |row|
    row.with_key(text: "Course")
    row.with_value(text: @course.name)
  end

  sl.with_row do |row|
    row.with_key(text: "Term")
    row.with_value(text: @course_cohort.term_identifier)
  end

end
%>

<%= form_with model: @course_cohort, url: admin_course_course_cohort_provider_path(@course, @course_cohort), method: :patch do |f| %>
  <%= f.govuk_error_summary %>

  <%= render "admin/course_cohort_providers/lead_providers_form",
             f:,
             lead_provider_options: @lead_providers,
             selection: @selected_lead_providers %>

  <div class="govuk-button-group">
    <%= f.govuk_submit "Save providers" %>
    <%= govuk_link_to("Cancel", admin_course_cohort_path(@course, @course_cohort.cohort), class: "govuk-link--no-visited-state") %>
  </div>
<% end %>
