<%= govuk_back_link href: admin_cohort_path(@schedule.cohort) %>

<h1 class="govuk-heading-l">Schedule</h1>

<%=
  govuk_summary_list do |sl|
    sl.with_row do |row|
      row.with_key(text: "Cohort")
      row.with_value(text: @schedule.cohort.description)
    end

    sl.with_row do |row|
      row.with_key(text: "Name")
      row.with_value(text: @schedule.name)
    end

    sl.with_row do |row|
      row.with_key(text: "Identifier")
      row.with_value(text: @schedule.identifier)
    end

    sl.with_row do |row|
      row.with_key(text: "Policy descriptor")
      row.with_value(text: @schedule.policy_descriptor || "-")
    end

    sl.with_row do |row|
      row.with_key(text: "Course group")
      row.with_value(text: @schedule.course_group)
    end

    sl.with_row do |row|
      row.with_key(text: "Training starts")
      row.with_value(text: @schedule.training_starts_at.to_date.to_fs(:govuk))
    end

    sl.with_row do |row|
      row.with_key(text: "Training ends")
      row.with_value(text: @schedule.training_ends_at.to_date.to_fs(:govuk))
    end

    sl.with_row do |row|
      row.with_key(text: "Acceptance window start")
      row.with_value(text: @schedule.acceptance_window_start&.to_date&.to_fs(:govuk))
    end

    sl.with_row do |row|
      row.with_key(text: "Acceptance window end")
      row.with_value(text: @schedule.acceptance_window_end&.to_date&.to_fs(:govuk))
    end

    sl.with_row do |row|
      row.with_key(text: "Declaration types")
      row.with_value(text: @schedule.allowed_declaration_types.join(", "))
    end
  end
%>

<% if current_admin.super_admin? %>
  <%= govuk_button_link_to "Edit schedule details", edit_admin_cohort_schedule_path(@schedule.cohort, @schedule) %>
  <%= govuk_button_link_to "Delete schedule", admin_cohort_schedule_path(@schedule.cohort, @schedule), method: :delete, warning: true %>
<% end %>
