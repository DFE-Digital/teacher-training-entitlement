<%= govuk_back_link href: url_for(:back) %>

<h1 class="govuk-heading-l">
  <% if @schedule.new_record? %>
    New schedule
  <% else %>
    Edit schedule <%= @schedule.name %>
  <% end %>
</h1>

<%= form_with model: [:admin, @cohort, @schedule] do |f| %>
  <%= f.govuk_text_field :name, class: "govuk-input--width-20" %>

  <%= f.govuk_text_field :identifier, class: "govuk-input--width-20" %>

  <%= f.govuk_text_field :policy_descriptor, class: "govuk-input--width-2", label: { text: "Policy descriptor" } %>

  <%=
    f.govuk_select :course_group,
                              options_for_select(Schedule.course_groups.keys.sort, @schedule.course_group),
                              options: { include_blank: true },
                              label: { text: "Course group" }
  %>

  <%= f.govuk_date_field :training_starts_at, legend: { text: "Training starts" } %>

  <%= f.govuk_date_field :training_ends_at, legend: { text: "Training ends" } %>

  <%= f.govuk_date_field :acceptance_window_start, legend: { text: "Acceptance window start" } %>

  <%= f.govuk_date_field :acceptance_window_end, legend: { text: "Acceptance window end" } %>

  <%=
    f.govuk_collection_check_boxes :allowed_declaration_types,
                                   Schedule.allowed_declaration_types,
                                   :to_s,
                                   :to_s,
                                   legend: { text: "Declaration types" }
  %>

  <%= f.govuk_submit @schedule.new_record? ? "Create schedule" : "Update schedule" %>
<% end %>
