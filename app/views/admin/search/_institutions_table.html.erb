<%=
govuk_table do |table|
  table.with_head do |header|
    header.with_row do |row|
      row.with_cell(text: "Workplace name")
      row.with_cell(text: "ID")
      row.with_cell(text: "URN (unique reference number)")
      row.with_cell(text: "UKPRN (UK provider reference number)")
      row.with_cell(text: "Local authority")
      row.with_cell(text: "Address")
    end
  end

  table.with_body do |body|
    institutions.each do |institution|
      body.with_row do |row|
        row.with_cell(text: institution.name)
        row.with_cell(text: institution.id)
        row.with_cell(text: institution.urn)
        row.with_cell(text: institution.ukprn)
        row.with_cell(text: institution.school? ? institution.institutionable.la_name : nil)
        row.with_cell(text: institution.address_string)
      end
    end
  end
end
%>
