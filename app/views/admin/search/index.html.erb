<% content_for :full_width, true %>

<h1 class="govuk-heading-l">Search</h1>

<div class="admin-search-box">
  <%= form_with url: admin_search_path, method: :get do |f| %>
    <h2 class="govuk-heading-m">Find a user or application</h2>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-half">
        <%= f.govuk_text_field(
              :q,
              value: params[:q],              
              label: { text: "Name, email, TRN, user ID, application ID, declaration ID or URN", size: "s" },
            )
        %>
      </div>

      <div class="govuk-grid-column-one-quarter">
        <%=
          f.govuk_collection_select(
            :status,
            Application::STATUSES,
            :to_s,
            :humanize,
            options: { selected: params[:status], include_blank: "All" },
            label: { text: "Application status", size: "s" },
          )
        %>
      </div>

      <div class="govuk-grid-column-one-quarter">
        <%=
          f.govuk_collection_select(
            :work_setting,
            Application.distinct(:work_setting).pluck(:work_setting).compact.sort,
            :to_s,
            :humanize,
            options: { selected: params[:work_setting], include_blank: "All" },
            label: { text: "Work setting", size: "s" },
          )
        %>
      </div>
    </div>

    <%= f.govuk_submit "Search" %>
  <% end %>
</div>

<% if @applications&.any? || @users&.any? %>
  <%= govuk_tabs do |tabs| %>
    <%= tabs.with_tab(id: "applications", label: "Applications (#{@pagy_applications.count})") do %>
      <% if @applications.any? %>
        <%= render "admin/search/applications_table", applications: @applications, pagy: @pagy_applications %>
      <% else %>
        <p class="govuk-body">No applications match the search and filters.</p>
      <% end %>
    <% end %>
    <%= tabs.with_tab(id: "users", label: "Users (#{@pagy_users&.count || 0})") do %>
      <% if @users&.any? %>
        <% if @users.any? %>
          <%= render "admin/search/users_table", users: @users, pagy: @pagy_users %>
        <% else %>
          <p class="govuk-body">No users match the search and filters.</p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @search_requested && !(@applications&.any? || @users&.any?)  %>
  <p class="govuk-body">No users or applications match the search and filters.</p>
<% end %>
