<% content_for :full_width, true %>

<h1 class="govuk-heading-l">Search</h1>

<div class="admin-search-box">
  <%= form_with url: admin_search_path, method: :get do |f| %>
    <h2 class="govuk-heading-m">Find a teacher or application</h2>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-half">
        <%= f.govuk_text_field(
              :q,
              value: params[:q],              
              label: { text: "Name, email, TRN, teacher ID, application ID, declaration ID or URN", size: "s" },
            )
        %>
      </div>

      <div class="govuk-grid-column-one-quarter">
        <%=
          f.govuk_collection_select(
            :status,
            Application::STATUSES,
            :to_s,
            :humanize,
            options: { selected: params[:status], include_blank: "All" },
            label: { text: "Application status", size: "s" },
          )
        %>
      </div>
    </div>

    <%= f.govuk_submit "Search" %>
  <% end %>
</div>

<% if @applications&.any? || @teachers&.any? %>
  <% tabs_to_render = params[:tab] == "teachers" ? %w[teachers applications] : %w[applications teachers] %>

  <%= govuk_tabs do |tabs| %>
    <% tabs_to_render.each do |tab| %>
      <% if tab == "applications" %>
        <%= tabs.with_tab(id: "applications", label: "Applications (#{@pagy_applications.count})") do %>
          <% if @applications.any? %>
            <%= render "admin/search/applications_table", applications: @applications, pagy: @pagy_applications %>
          <% else %>
            <p class="govuk-body">No applications match the search and filters.</p>
          <% end %>
        <% end %>
      <% else %>
        <%= tabs.with_tab(id: "teachers", label: "Teachers (#{@pagy_teachers&.count || 0})") do %>
          <% if @teachers&.any? %>
            <%= render "admin/search/teachers_table", teachers: @teachers, pagy: @pagy_teachers %>
          <% else %>
            <p class="govuk-body">No teachers match the search and filters.</p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @search_requested && !(@applications&.any? || @teachers&.any?)  %>
  <p class="govuk-body">No teachers or applications match the search and filters.</p>
<% end %>
