<%=
  govuk_table do |table|
    table.with_head do |header|
      header.with_row do |row|
        row.with_cell(text: "Name")
        row.with_cell(text: "TRN")
        row.with_cell(text: "Date added")
      end
    end

    table.with_body do |body|
      teachers.each do |teacher|
        body.with_row do |row|
          row.with_cell(text: govuk_link_to(teacher.full_name, admin_teacher_path(teacher)))
          row.with_cell(text: teacher.trn)
          row.with_cell(text: teacher.created_at.to_date.to_formatted_s(:govuk))
        end
      end
    end
  end
%>
<%= govuk_pagination(pagy:) %>
