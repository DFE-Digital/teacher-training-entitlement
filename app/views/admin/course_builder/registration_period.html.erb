<% content_for(:page_title) { @wizard.step_title } %>

<%= govuk_back_link href: @wizard.previous_step_path(fallback: admin_path) %>

<h1 class="govuk-heading-l"><%= @wizard.step_title %></h1>

<%= form_with model: @wizard.current_step, scope: @wizard.current_step_name, url: @wizard.current_step_path do |f| %>
  <%= f.govuk_error_summary %>

  <%= f.govuk_select :cohort_id,
                     options_from_collection_for_select(
                       Cohort.order_by_latest,
                       :id,
                       :name,
                       @wizard.current_step.cohort_id,
                     ),
                     options: { include_blank: true },
                     label: { text: "Existing cohort", size: "s" } %>

  <p class="govuk-body">Or create a new cohort registration period</p>

  <%= f.govuk_date_field :registration_starts_at,
                         legend: { text: "Registration start date", size: "s" } %>

  <%= f.govuk_select :registration_period_length,
                     options_for_select(
                       Admin::CourseBuilder::Steps::RegistrationPeriod::REGISTRATION_PERIOD_LENGTHS,
                       @wizard.current_step.registration_period_length,
                     ),
                     options: { include_blank: true },
                     label: { text: "Registration period length", size: "s" } %>

  <%= f.govuk_submit "Continue" %>
<% end %>
