<% rows = Array(local_assigns.fetch(:rows)).map { |row| row.to_h.with_indifferent_access } %>
<% columns = rows.flat_map(&:keys).uniq %>

<% if rows.any? && columns.any? %>
  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          columns.each do |column|
            row.with_cell(text: column.to_s.humanize)
          end
        end
      end

      table.with_body do |body|
        rows.each do |answer_row|
          body.with_row do |row|
            columns.each do |column|
              row.with_cell(text: answer_row[column].presence || "-")
            end
          end
        end
      end
    end
  %>
<% end %>
