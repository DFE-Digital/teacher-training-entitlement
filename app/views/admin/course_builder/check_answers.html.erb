<%= govuk_back_link href: @wizard.previous_step_path(fallback: admin_courses_path) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Check answers</h1>

    <% if @wizard.course_cohorts.any? %>
      <h2 class="govuk-heading-m">Additional course cohorts</h2>

      <%= render "check_answers_table",
                 rows: @wizard.course_cohorts.map { |course_cohort| course_cohort.fetch(:attributes, {}).merge(course_id: course_cohort[:course_id]) } %>
    <% end %>

    <% @wizard.raw_data.fetch(:steps, {}).except(:create_milestone, :check_answers).each do |step_name, step_data| %>
      <h2 class="govuk-heading-m"><%= step_name.to_s.humanize %></h2>

      <%= render "check_answers_table", rows: [step_data] %>
    <% end %>

    <h2 class="govuk-heading-m">Milestones</h2>

    <%= render "check_answers_table", rows: @wizard.milestones %>

    <%= form_with url: @wizard.current_step_path, method: :patch do |f| %>
      <%= f.govuk_submit "Finish" %>
    <% end %>
  </div>
</div>
