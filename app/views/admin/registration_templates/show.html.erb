<%= govuk_back_link(href: admin_registration_templates_path) %>

<h1 class="govuk-heading-l"><%= @registration_template.name.presence || "Untitled registration template" %></h1>

<div class="govuk-button-group">
  <%= govuk_link_to "Edit", edit_admin_registration_template_path(@registration_template), class: "govuk-button" %>
  <%= govuk_button_link_to "Delete", admin_registration_template_path(@registration_template), method: :delete, warning: true %>
</div>

<%=
  govuk_summary_list do |summary_list|
    summary_list.with_row do |row|
      row.with_key(text: "Description")
      row.with_value(text: @registration_template.description.presence || "—")
    end

    summary_list.with_row do |row|
      row.with_key(text: "Template-generating service class")
      row.with_value(text: @registration_template.template_generating_service_class.presence || "—")
    end
  end
%>

<div class="govuk-!-padding-top-8">
  <h2 class="govuk-heading-m">Create journey from template</h2>

  <% registration_journey = @registration_journey || RegistrationJourney.new %>

  <%= form_with model: registration_journey,
                scope: :registration_journey,
                url: admin_registration_template_journey_path(@registration_template) do |form| %>
    <%= form.govuk_error_summary %>

    <%=
      form.govuk_text_field :name,
                            width: "two-thirds",
                            label: {
                              text: "Journey name",
                              size: "m",
                            }
    %>

    <%=
      form.govuk_text_field :slug,
                            width: "two-thirds",
                            label: {
                              text: "Journey slug",
                              size: "m",
                            }
    %>

    <%= form.govuk_submit "Create journey" %>
  <% end %>
</div>
