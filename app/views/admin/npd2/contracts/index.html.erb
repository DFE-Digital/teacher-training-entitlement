<h1 class="govuk-heading-l">Contracts</h1>

<% if @contracts.any? %>
  <%=
    govuk_table do |table|
      table.with_head do |head|
        head.with_row do |row|
          row.with_cell(text: "Contract")
          row.with_cell(text: "Lead provider")
          row.with_cell(text: "Policy periods")
        end
      end

      table.with_body do |body|
        @contracts.each do |contract|
          body.with_row do |row|
            row.with_cell(text: contract.name.presence || "Contract ##{contract.id}")
            row.with_cell(text: contract.lead_provider.name)
            row.with_cell do
              if contract.policy_periods.any?
                tag.ul(class: "govuk-list govuk-list--bullet") do
                  safe_join(
                    contract.policy_periods.order(:start_date).map do |policy_period|
                      tag.li([
                        policy_period.name,
                        "#{policy_period.start_date.to_fs(:govuk)} to #{policy_period.end_date.to_fs(:govuk)}",
                      ].join(" - "))
                    end,
                  )
                end
              else
                "No policy periods"
              end
            end
          end
        end
      end
    end
  %>
<% else %>
  <p class="govuk-body">No contracts found.</p>
<% end %>
