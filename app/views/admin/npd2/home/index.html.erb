<% content_for :head do %>
  <%= nonced_javascript_include_tag "mermaid", defer: true %>
<% end %>

<h2 class="govuk-heading-m">Conceptual domain split between API/applications/declarations and the finance/contract side.</h2>

<p class="govuk-body">
  A declaration allows us to record the progress of participants through the course.
  <br/>
  A declaration is made on an application which gives us the course cohort, and valid milestones for that course cohort.
</p>

<p class="govuk-body">
  A policy period allows us to define a broader period (such as AY 26/27, or a funding period from 2026 to 2029)
  <br/>
  A policy period can have many contracts per lead provider, or one contract can span multiple policy periods.
</p>
<p class="govuk-body">
  A course cohort provider is the link between what providers are linked to which course/cohorts and which contract.
  <br/>
  A contract can cover a single course cohort, or many.  
</p>

<p class="govuk-body">
  When generating statements a contract is linked to a course cohort provider, which 
  describes which course cohorts a statement should be generated for.
  <br/>
  Flexible time period billing cycles can be catered for because a contract/course/cohort link
  allows declarations to be discovered via the milestones linked to a course cohort.
</p>

<p class="govuk-body">
  <a href="/admin/npd2/policy-periods">Link to policy period view showing what courses/cohorts/milestones are configured</a>
  <br/>
  <a href="/admin/npd2/statements">Link to statement view - allows generation of statements</a>
</p>
<h2 class="govuk-heading-m">Conceptual model view - split between API side and Finance side</h2>

<div class="mermaid">
  <%= h([
    "flowchart LR",
    "  subgraph application_domain[\"Application / course delivery\"]",
    "    direction TB",
    "    PolicyPeriod[\"PolicyPeriod\"]",
    "    Course[\"Course\"]",
    "    CourseCohort[\"CourseCohort\"]",
    "    Application[\"Application\"]",
    "    Milestone[\"Milestone<br/>started / completed\"]",
    "    PolicyPeriod --> CourseCohort",
    "    Course --> CourseCohort",
    "    CourseCohort --> Application",
    "    CourseCohort --> Milestone",
    "  end",
    "  subgraph boundary[\"Conceptual wall\"]",
    "    direction TB",
    "    Declaration[\"Declaration:<br/>the boundary between<br/>API & Finance\"]",
    "  end",
    "  subgraph finance_domain[\"Finance / payment\"]",
    "    direction TB",
    "    LeadProvider[\"LeadProvider\"]",
    "    Contract[\"Contract\"]",
    "    ContractPolicyPeriod[\"ContractPolicyPeriod\"]",
    "    CourseCohortProvider[\"CourseCohortProvider\"]",
    "    FinanceMilestone[\"Milestone\"]",
    "    Statement[\"Statement\"]",
    "    LeadProvider --> Contract",
    "    ContractPolicyPeriod --> Contract",
    "    Contract --> CourseCohortProvider",
    "    CourseCohortProvider --> FinanceMilestone",
    "    Contract --> Statement",
    "  end",
    "  Application --> Declaration",
    "  Milestone --> Declaration",
    "  PolicyPeriod --> ContractPolicyPeriod",
    "  CourseCohort --> CourseCohortProvider",
    "  Declaration --> FinanceMilestone",
    "  Declaration --> Statement",
    "  classDef delivery fill:#e8f1f8,color:#0b0c0c,stroke:#1d70b8,stroke-width:2px",
    "  classDef finance fill:#f3f2f1,color:#0b0c0c,stroke:#505a5f,stroke-width:2px",
    "  classDef bridge fill:#fff7bf,color:#0b0c0c,stroke:#ffdd00,stroke-width:3px",
    "  class PolicyPeriod,Course,CourseCohort,Application,Milestone delivery",
    "  class LeadProvider,Contract,ContractPolicyPeriod,CourseCohortProvider,FinanceMilestone,Statement finance",
    "  class Declaration bridge",
  ].join("\n")) %>
</div>

