<%= govuk_back_link href: admin_application_path(@form.application) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      Change status
    </h1>

    <div class="govuk-inset-text">
      <p class="govuk-body">
        <strong>User ID / Participant ID</strong>
        <br/>
        <%= @form.application.user.id %>
      </p>
      <p class="govuk-body">
        <strong>Training status</strong>
        <br/>
        <%= @form.application.status&.humanize || "-" %>
      </p>
    </div>

    <%= form_for @form,
                as: :form,
                 url: admin_applications_change_status_path(@form.application) do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_collection_radio_buttons :status,
                                           @form.status_options,
                                           :to_s,
                                           :humanize,
                                           legend: { tag: 'h1', size: 'm' } %>

      <%= f.govuk_select(:reason, label: { tag: 'h1', size: 'm' },
                                  options: { include_blank: "- no reason -" }) do %>
        <%= grouped_options_for_select(@form.reason_options, @form.reason)  %>
      <% end %>

      <div class="govuk-button-group">
        <%= f.govuk_submit t("shared.continue") %>
        <%= govuk_link_to t("shared.cancel"), admin_application_path(@form.application) %>
      </div>
    <% end %>
  </div>
</div>
