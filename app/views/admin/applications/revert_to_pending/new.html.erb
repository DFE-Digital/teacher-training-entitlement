<%= govuk_back_link href: admin_application_path(@form.application) %>

<h1 class="govuk-heading-l">
  Are you sure you want to change the status to Pending?
</h1>

<div class="govuk-inset-text">
  <p class="govuk-body">
    Application status:
    <br />
    <strong><%= @form.application.status&.humanize %></strong>
  </p>
</div>

<%= form_for @form,
             as: :form,
             url: admin_applications_revert_to_pending_path(@form.application) do |f| %>
  <%= f.govuk_error_summary %>

  <%= f.govuk_collection_radio_buttons :change_status_to_pending,
                                       %w[yes no],
                                       :to_s,
                                       :humanize,
                                       legend: {
                                          text: "Change the status to pending?"
                                       } %>

  <div class="govuk-button-group">
    <%= f.govuk_submit "Change status to Pending" %>
    <%= govuk_link_to t("shared.cancel"), admin_application_path(@form.application) %>
  </div>
<% end %>
