<div class="d-flex">
  <h1 class="govuk-heading-m" style="margin: 0;">Started Declarations API Endpoint</h1>
  <div style="margin-left: 20px;">| <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: admin_applications_api_tests_path(@application)) %></div>
</div>


<div class="govuk-body">  
  <p>The Started Declarations endpoint creates a 'started' declaration for an accepted application.</p>
  <p class="govuk-heading-s">List of delivery partners for <%= @application.lead_provider.name %></p>
  <p>The Started Declarations endpoint requires a delivery partner to be chosen for.</p>
  <%= form_for :form, url: admin_applications_api_tests_started_declarations_path(@application) do |f| %>
    <%= f.govuk_select :delivery_partner_id, options_for_select(@delivery_partners.map{|dp| [ dp.name, dp.id ]}), label: { text: "Delivery partner", size: "s" } %>
    <%= f.govuk_submit("Call Started Declarations API") %>
  <% end %>

</div>