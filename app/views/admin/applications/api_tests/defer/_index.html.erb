<h1 class="govuk-heading-m">Defer API Endpoint</h1>
<%= render GovukComponent::BackLinkComponent.new(text: "Back", href: admin_applications_api_tests_path(@application)) %>

<div class="govuk-body">
  <p>The Defer endpoint defers a started application.</p>
  <%=
    form_for :form, url: admin_applications_api_tests_defer_index_path(@application) do |f|
      f.govuk_submit("Call Defer API")
    end
  %>
</div>
