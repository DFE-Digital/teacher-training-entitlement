<h1 class="govuk-heading-m">Withdraw API Endpoint</h1>
<%= render GovukComponent::BackLinkComponent.new(text: "Back", href: admin_applications_api_tests_path(@application)) %>

<div class="govuk-body">
  <p>The Withdraw endpoint withdraws a started or deferred application.</p>
  <%=
    form_for :form, url: admin_applications_api_tests_withdraw_index_path(@application) do |f|
      f.govuk_submit("Call Withdraw API")
    end
  %>
</div>
