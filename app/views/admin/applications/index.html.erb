<% content_for :side_navigation do %>
  <%= render RegistrationPeriodsComponent.new(
    request.path,
    base_path: :admin_applications_path,
    current_academic_year: @current_academic_year,
  ) %>
<% end %>

<h1 class="govuk-heading-l">Applications</h1>

<div class="admin-search-box">
  <%= form_with method: :get do |f| %>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-half">
        <%=
          f.govuk_collection_select(
            :status,
            Application::STATUSES,
            :to_s,
            :humanize,
            options: { selected: params[:status], include_blank: "All" },
            label: { text: "Application status", size: "s" },
          )
        %>
      </div>

      <div class="govuk-grid-column-one-half">
        <%=
          f.govuk_collection_select(
            :work_setting,
            Application.distinct(:work_setting).pluck(:work_setting).compact.sort,
            :to_s,
            :humanize,
            options: { selected: params[:work_setting], include_blank: "All" },
            label: { text: "Work setting", size: "s" }
          )
        %>
      </div>
    </div>

    <%= f.govuk_submit "Apply filters" %>
  <% end %>
</div>

<%=
  govuk_table do |table|
    table.with_head do |header|
      header.with_row do |row|
        row.with_cell(text: "Submitted")
        row.with_cell(text: "Name")
        row.with_cell(text: "Workplace")
        row.with_cell(text: "Status")
        row.with_cell(text: "Provider")
        row.with_cell(text: "Actions")
      end
    end

    table.with_body do |body|
      @applications.each do |application|
        body.with_row do |row|
          row.with_cell(text: application.created_at.to_fs(:govuk_short))
          row.with_cell(text: application.user.full_name)
          row.with_cell(text: application.institution&.name)
          row.with_cell do
            application_status_badge(application.status)
          end
          row.with_cell(text: application&.lead_provider&.name)
          row.with_cell(text: govuk_link_to("View", admin_application_path(application)))
        end
      end
    end
  end
%>

<% if @applications.none? %>
  <p class="govuk-body">No applications match the filters.</p>
<% end %>

<%= govuk_pagination(pagy: @pagy) %>
