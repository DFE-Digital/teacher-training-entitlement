<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <div class="govuk-panel govuk-panel--confirmation">
      <h1 class="govuk-panel__title">
        You have unsubscribed
      </h1>
    </div>

    <p class="govuk-body">
      You will not receive any further emails about the opening of NPD service.
    </p>

    <% if current_user&.persisted? %>
      <p class="govuk-body">
        Did you unsubscribe by accident?
        <%= form_for :form, url: email_updates_path do |f| %>
          <%= f.govuk_submit('Re-subscribe') %>
        <% end %>

      </p>
    <% else %>
      <p class="govuk-body">
        Did you unsubscribe by accident?
      </p>
      <%=
        render GovukComponent::ContinueButtonComponent.new(
          text: "Re-subscribe",
          href: user_teacher_auth_omniauth_authorize_path(request_email_updates: "true"),
          as_button: true
        )
      %>
    <% end %>
  </div>
</div>
