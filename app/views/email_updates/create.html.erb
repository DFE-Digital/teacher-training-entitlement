<% content_for :title, t("helpers.title.email_updates.create") %>

<div class="govuk-panel govuk-panel--confirmation">
  <h1 class="govuk-panel__title">You've signed up for email updates</h1>
</div>

<p class="govuk-body">We'll send updates to <strong><%= current_user.email %></strong> when registration opens for the next course.</p>

<% if current_user.applications.any? %>
  <p class="govuk-body"><%= govuk_link_to "View your existing registrations", applications_path %>.</p>
<% end %>
