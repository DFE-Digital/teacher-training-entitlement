<% result = wizard_step.state_store["funding_eligibility_result"] %>

<% if [Registrations::FundingEligibilityConstants::NOT_IN_ENGLAND,
       Registrations::FundingEligibilityConstants::INELIGIBLE_SETTING].include?(result) %>
  <% eligibility_result_text = if result == Registrations::FundingEligibilityConstants::NOT_IN_ENGLAND
                                 "You're not eligible because you're not in England"
                               else
                                 "You're not eligible for scholarship funding because you do not work in an eligible setting"
                               end %>
  <p class="govuk-body"><%= eligibility_result_text %>.</p>

  <p class="govuk-body">This means that you would need to pay for the course another way. For example, you could pay for the course fees yourself or ask your workplace or trust to:</p>

  <ul class="govuk-list govuk-list--bullet">
    <li>cover the full cost of the course</li>
    <li>share the cost of the course with you</li>
  </ul>
<% elsif result == Registrations::FundingEligibilityConstants::FUNDED %>
  <p class="govuk-body">You're eligible for funding.</p>

  <h2 class="govuk-heading-m">What happens next</h2>
  <ol class="govuk-list govuk-list--number">
    <li>When you submit your registration, we notify your provider that you're eligible for a funded place</li>
    <li>Your provider will contact you to complete your application and confirm if a place is available</li>
  </ol>
<% elsif result == Registrations::FundingEligibilityConstants::PREVIOUSLY_FUNDED %>
  <p class="govuk-body">You've already been allocated scholarship funding for the course.</p>

  <p class="govuk-body">If you need to change something about your course or provider, email continuing-professional-development@digital.education.gov.uk.</p>

  <h2 class="govuk-heading-m">If you're taking the course again</h2>

  <p class="govuk-body">Continue to register.</p>

  <p class="govuk-body">You would need to pay for the course another way if you were previously funded but you did not pass or withdrew from the course. For example you could pay for the course fees yourself or ask your workplace or trust to:</p>

  <ul class="govuk-list govuk-list--bullet">
    <li>cover the full cost of the course</li>
    <li>share the cost of the course with you</li>
  </ul>
<% else %>
  <% raise ArgumentError, "Unsupported funding eligibility result: #{result.inspect}" %>
<% end %>
