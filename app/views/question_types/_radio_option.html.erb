<% if radio_option.divider %>
  <%= form.govuk_radio_divider %>
<% end %>

<%= form.govuk_radio_button(question.name, radio_option.value, **radio_option.to_options) do %>
  <% if radio_option.revealed_question.present? %>
    <%=
      render(
        "question_types/#{radio_option.revealed_question.type}",
        form: form,
        question: radio_option.revealed_question
      )
    %>
  <% end %>
<% end %>
