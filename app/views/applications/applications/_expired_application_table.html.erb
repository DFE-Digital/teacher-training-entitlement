<%=
  govuk_summary_list(card: { title: application.course.title_embedded_course_name }) do |sl|
    sl.with_row do |row|
      row.with_key(text: "Provider")
      row.with_value(text: application.lead_provider.name)
    end

    sl.with_row do |row|
      row.with_key(text: "Registration submitted")
      row.with_value(text: application.created_at.to_date.to_fs(:govuk_short))
    end

    sl.with_row do |row|
      row.with_key(text: "Provider application")
      row.with_value do
        concat govuk_tag(text: "Expired", colour: "grey")

        if Feature.registration_closed?(current_user)
          concat tag.p("Your registration has expired but you can register again for future courses when registrations open.", class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
        else
          concat tag.p do
            concat link_to("Submit a new registration", registration_wizard_show_path(:course_start_date))
            concat " if you still want to take this course."
          end
        end
      end
    end
  end
%>
