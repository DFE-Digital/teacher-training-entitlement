<% content_for :title, "Your registration details" %>
<% if flash.present? %>
  <%= render GovukComponent::NotificationBannerComponent.new(success: flash[:notice].present?, title_text: flash[:notice]&.dig(:title) || flash[:alert]&.dig(:title)) do %>
    <p class="govuk-body"><%=  flash[:notice]&.dig(:message).presence || flash[:alert]&.dig(:message) %></p>
  <% end %>
<% end %>
<% content_for :before_content do %>
  <% if current_user.applications.count > 1 %>
    <%= render GovukComponent::BackLinkComponent.new(
      text: "Back to your registrations",
      href: applications_path
    ) %>
  <% else %>
    <%= render GovukComponent::BackLinkComponent.new(
      text: "Back",
      href: request.referrer
    ) %>
  <% end %>
<% end %>
<span class="govuk-caption-m">Submitted <%= @application.created_at.to_date.to_fs(:govuk_short) %></span>
<h1 class="govuk-heading-xl">Your <%= title_embedded_course_name(@application.course) %> registration</h1>

<p class="govuk-body"><strong>Application ID:</strong> <%= @application.ecf_id %></p>

<%= render "course_details", application: @application %>
<%= render "funding_details", application: @application %>
<%= render "personal_details", application: @application %>
<%= render "work_details", application: @application %>