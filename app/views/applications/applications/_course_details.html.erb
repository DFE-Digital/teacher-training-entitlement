<%=
  govuk_summary_list(card: { title: "Course details" }) do |sl|
    sl.with_row do |row|
      row.with_key(text: "Course")
      row.with_value(text: application.course.title_embedded_course_name)
    end

    sl.with_row do |row|
      row.with_key(text: "Provider")
      row.with_value(text: application.lead_provider.name)

      if application.can_change_provider?
        row.with_action(text: "Register with a different provider", href: application_change_provider_start_index_path(application.ecf_id))
      end

      if application.accepted_status?
        row.with_action(text: "Register with a different provider", href: application_change_provider_contact_us_path(application.ecf_id))
      end
    end

    sl.with_row do |row|
      row.with_key(text: "Provider application")
      row.with_value do
        if application.pending_status?
          concat govuk_tag(text: "Apply with provider", colour: application_status_colour(application.status))
          concat render("provider_pending_status")
        elsif application.accepted_status?
          concat govuk_tag(text: "Successful", colour: application_status_colour(application.status))
        elsif application.rejected_status?
          concat govuk_tag(text: "Unsuccessful", colour: application_status_colour(application.status))
        elsif application.deferred_status?
          concat application_status_badge(application.status)
          concat render("deferral_details", application:)
        elsif application.withdrawn_status?
          concat application_status_badge(application.status)
          concat render("withdrawal_details", application:)
        else
          concat application_status_badge(application.status)
        end
      end
    end

    unless application.completed_status?
      sl.with_row do |row|
        row.with_key(text: "Course start")
        row.with_value do
          concat application_course_start_date.titleize

          if application.pending_status? || application.accepted_status?
            if application.eligible_for_funding
              concat tag.p(I18n.t("course_start_details.eligible_for_funding", date: application_course_start_date), class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
            else
              concat tag.p(I18n.t("course_start_details.not_eligible_for_funding", date: application_course_start_date), class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
            end
          end
        end
      end
    end

    if application.completed_status?
      sl.with_row do |row|
        row.with_key(text: "Course outcome")
        row.with_value do
          concat govuk_tag(text: "Completed", colour: "green")
          concat tag.p(t("course.outcome.passed_html"), class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
        end
      end
    end
  end
%>
