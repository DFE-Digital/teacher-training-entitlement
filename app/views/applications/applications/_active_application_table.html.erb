<%=
  govuk_summary_list(
    card: {
      title: application.course.title_embedded_course_name,
      actions: [govuk_link_to("View details", application_path(application.ecf_id))],
    },
  ) do |sl|
    sl.with_row do |row|
      row.with_key(text: "Provider")
      row.with_value(text: application.lead_provider.name)
    end

    sl.with_row do |row|
      row.with_key(text: "Registration submitted")
      row.with_value(text: application.created_at.to_date.to_fs(:govuk_short))
    end

    sl.with_row do |row|
      row.with_key(text: "Provider application")
      row.with_value do
        if application.status.blank? || pending?(application)
          concat govuk_tag(text: "Apply with provider", colour: "yellow")
          concat render("provider_pending_status")
        elsif application.accepted_status?(application)
          concat govuk_tag(text: "Successful", colour: "green")
        elsif application.rejected_status?
          concat govuk_tag(text: "Unsuccessful", colour: "red")
        end
      end
    end

    if application.completed_status?
      sl.with_row do |row|
        row.with_key(text: "Course outcome")
        row.with_value do
          concat govuk_tag(text: "Completed", colour: "green")
          concat tag.p(t("course.outcome.passed_html"), class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
        end
      end
    end
  end
%>
