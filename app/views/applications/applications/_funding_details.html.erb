<%=
  govuk_summary_list(card: { title: "Funding details" }) do |sl|
    sl.with_row do |row|
      row.with_key(text: "Scholarship funding")
      row.with_value do
        concat funding_status_badge(application)

        if application.eligible_for_funding
          concat render("eligible_for_funding_details", application: @application)
        elsif scholarship_eligibility_in_review?(application)
          concat render("in_review_funding_details", application: @application)
        else
          concat tag.p(scholarship_funding_eligibility(application), class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
          concat tag.p(I18n.t("funding_details.ineligible_message"), class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
        end
      end
    end

    if !application.eligible_for_funding? && application.raw_application_data["funding"].present?
      sl.with_row do |row|
        row.with_key(text: "Course funding")
        row.with_value do
          concat "#{I18n.t(application.raw_application_data["funding"], scope: "helpers.label.registration_wizard.funding_options")}."
          concat tag.p("You may want to check the cost of the course with your provider.", class: "govuk-!-margin-top-2 govuk-!-margin-bottom-0")
        end
      end
    end
  end
%>
