<%=
  govuk_summary_list(card: { title: "Work details" }) do |sl|
    sl.with_row do |row|
      row.with_key(text: "Workplace in England")
      row.with_value(text: boolean_tag(application.inside_catchment?))
    end

    if application.work_setting.present?
      sl.with_row do |row|
        row.with_key(text: "Work setting")
        row.with_value(text: I18n.t(application.work_setting, scope: "helpers.label.registration_wizard.work_setting_options"))
      end
    end

    if application.inside_catchment? && application.school.present?
      sl.with_row do |row|
        row.with_key(text: "Workplace")
        row.with_value(text: application.institution&.name_with_address || "")
      end
    end
  end
%>
