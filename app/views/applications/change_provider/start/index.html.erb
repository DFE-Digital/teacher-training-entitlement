<% content_for :title, t("applications.change_provider.start.title", course_name: application.course.name) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <%= t("applications.change_provider.start.title", course_name: application.course.name) %>
    </h1>
    <% start_text = t("applications.change_provider.start.text.application_#{application.status}") %>
    <% if start_text.present? %>
      <p class="govuk-body"><%= start_text %></p>
    <% end %>

    <h2 class="govuk-heading-m">
      <%= t("applications.change_provider.start.what_happens.title") %>
    </h2>

    <div class="govuk-body">
      <ul class="govuk-list govuk-list--bullet">
        <% t("applications.change_provider.start.what_happens.text").each do |line| %>
          <li><%= line %></li>
        <% end %>
      </ul>

      <%= form_for @form, as: :form, url: application_change_provider_start_index_path(application.ecf_id) do |f| %>
        <%= f.govuk_error_summary %>
        <%= f.govuk_radio_buttons_fieldset :confirmation, legend: { text: t("applications.change_provider.start.application_#{application.status}.form.title"), tag: 'h1', size: 'm' } do %>
          <%= f.govuk_radio_button :confirmation, '1', checked: @form.confirmation, label: { text: t("applications.change_provider.start.application_#{application.status}.form.yes_option") }, link_errors: true %>
          <%= f.govuk_radio_button :confirmation, '0', label: { text: t("applications.change_provider.start.application_#{application.status}.form.no_option") } %>
        <% end %>
        <div class="govuk-button-group">
          <%= f.govuk_submit t("shared.continue") %>
          <%= govuk_link_to t("shared.cancel"), application_path(application.ecf_id) %>
        </div>
      <% end %>
    </div>
  </div>
</div>