<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: @wizard.previous_step_path) %>
    <h1 class="govuk-heading-l">
      <%= t("applications.change_provider.check_answers.title") %>
    </h1>

    <%= form_with model: current_step,
          url: @wizard.current_step_path,
          scope: current_step_name,
          method: :patch do |f| %>
      <div id="new-provider" class="govuk-grid-row govuk-body">
        <div class="govuk-grid-column-one-third">
          <strong><%= t("applications.change_provider.check_answers.new_provider") %></strong>
        </div>
        <div class="govuk-grid-column-one-third">
          <div><%= current_step.new_provider&.name %></div>
        </div>
        <div class="govuk-grid-column-one-third">
          <div><%= govuk_link_to t("shared.change"), application_change_provider_path(application.ecf_id, "choose-provider") %></div>
        </div>
      </div>
      <hr/>
      <div class="govuk-body govuk-!-padding-top-4">
        <%= f.govuk_submit t("applications.change_provider.check_answers.form.button") %>
        <%= govuk_link_to t("shared.cancel"), application_path(application.ecf_id), class: "govuk-!-padding-left-4" %>
      </div>
    <% end %>
  </div>
</div>