<%= govuk_footer do |footer| %>

  <% footer.with_meta_html do %>
    <h2 class="govuk-heading-m">Support and guidance</h2>

    <p class="govuk-body-s">
      If you have a question, or you’ve had a problem using this service, please contact us at<br/>
      <%= govuk_footer_link_to("continuing-professional-development@digital.education.gov.uk", "mailto:continuing-professional-development@digital.education.gov.uk") %>
    <p>

    <ul class="govuk-footer__inline-list">
      <li class="govuk-footer__inline-list-item">
        <%= govuk_footer_link_to("Cookies", cookies_path) %>
      </li>
      <li class="govuk-footer__inline-list-item">
        <%= govuk_footer_link_to("Privacy", PRIVACY_NOTICE_URL, target: "_blank", rel: "noopener noreferrer") %>
      </li>
      <li class="govuk-footer__inline-list-item">
        <%= govuk_footer_link_to("Accessibility", accessibility_statement_path) %>
      </li>
    </ul>
  <% end %>

<% end %>
