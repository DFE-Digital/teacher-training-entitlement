<%= render "reception_registrations/backlink", step: @step %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: current_step,
          url: @wizard.current_step_path,
          scope: current_step_name,
          method: :patch do |f| %>
      <%= f.govuk_error_summary %>
      <% legend = { text: I18n.t("helpers.legend.registration_wizard.lead_provider_id"), tag: "h1", size: "xl" } %>
      <%= f.govuk_radio_buttons_fieldset(:lead_provider_id, **{ legend:, tag: "h2", size: "m" }) do %>
        <% current_step.lead_providers.each do |lead_provider| %>
          <%= f.govuk_radio_button(:lead_provider_id, lead_provider.id, value: 1, checked: current_step.lead_provider_id.to_s == lead_provider.id.to_s, hint: { text: lead_provider.hint }, label: { text: lead_provider.name }) %>
        <% end %>
      <% end %>
      <%= f.govuk_radio_button(:lead_provider_id, current_step.not_chosen_option, label: { text: I18n.t("helpers.label.registration_wizard.lead_provider_id_options.not_chosen") }) %>

      <%= govuk_warning_text(text: t('helpers.warnings.registration_wizard.check_provider_is_open')) %>

      <%= f.govuk_submit %>
    <% end  %>
  </div>
</div>
