    
<h1 class="govuk-heading-xl"><%= t("helpers.title.registration_wizard.choose_your_course") %></h1>

<h3 class="govuk-heading-m"><%= current_step.course.name %></h3>
<h4 class="govuk-heading-s"><%= current_step.course.description %></h4>

<% t("helpers.hint.registration_wizard.choose_your_course", link: "<a href=''>learn more about the DfE CPD offering</a>").each do |t| %>
  <p class="govuk-body govuk-!-margin-bottom-7"> <%= t.html_safe %> </p>
<% end %>

<%= render "reception_registrations/backlink", step: @step %>

<%= form_with model: current_step,
          url: @wizard.current_step_path,
          scope: current_step_name,
          method: :patch do |f| %>
  <%= f.govuk_error_summary %>
  <%= f.hidden_field :course_identifier, value: current_step.course.identifier %>
  <%= f.govuk_submit %>
<% end  %>
