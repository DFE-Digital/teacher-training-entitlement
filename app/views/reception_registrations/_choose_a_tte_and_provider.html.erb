<% content_for :title do %>
  <%= t("helpers.title.registration_wizard.choose_a_tte_and_provider") %>
<% end %>

<% content_for :before_content do %>
  <%= render GovukComponent::BackLinkComponent.new(text: "Back", href: reception_registration_path("choose-your-provider")) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Choose a TTE course and provider</h1>

    <p class="govuk-body"><%= external_link_to "Learn about TTEs", :learn_about_ttes %>, including providers and funding.</p>

    <p class="govuk-body">If you're employed, speak to your manager for support. They may have a recommended provider for your training.</p>
  </div>
</div>
