<%= render "reception_registrations/backlink", step: @step %>

<h1 class="govuk-heading-xl">Funding eligibility result</h1>

<p class="govuk-body">You are eligible for funding.</p>

<h2 class="govuk-heading-m">What happens next</h2>
<ol class="govuk-list govuk-list--number">

  <li>When you submit your registration we will notify your provider that you are eligible for a funded place</li>
  <li>Your provider will contact you to complete your application and confirm if a funded place is available</li>
</ol>
<%= form_with model: current_step,
      url: @wizard.current_step_path,
      scope: current_step_name,
      method: :patch do |f| %>
  <%= f.govuk_submit %>
<% end %>
