<% content_for :title do %>
  <%= t("helpers.title.registration_wizard.ineligible_for_funding") %>
<% end %>

<%= render "reception_registrations/backlink", step: @step %>
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render "reception_registrations/ineligible_for_funding/#{@wizard.state_store.inelegible_for_funding_type}", course: @wizard.state_store.course, lead_provider: @wizard.state_store.lead_provider&.name %>

    <%= govuk_button_link_to "Continue", reception_registration_path("funding-your-course") %>

  </div>
</div>

<% if Rails.env.staging? || Rails.env.development? %>
  <p class="govuk-body">
    Ineligible type: "<%= @wizard.state_store.inelegible_for_funding_type %>"
    <br />
    <i>Note: this will not show in production</i>
  </p>
<% end  %>
