<%= render "reception_registrations/backlink", step: @step %>
<%= render "reception_registrations/ineligible_for_funding/#{@wizard.state_store.funding_eligibility_status_code}", course: @wizard.state_store.course, lead_provider: @wizard.state_store.lead_provider&.name %>

<%= govuk_button_link_to "Continue", reception_registration_path("funding-your-course") %>

<% unless Rails.env.production? %>
  <p class="govuk-body">
    Ineligible type: "<%= @wizard.state_store.funding_eligibility_status_code %>"
    <br />
    <i>Note: this will not show in production</i>
  </p>
<% end  %>
