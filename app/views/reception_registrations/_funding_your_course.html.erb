<%= render "reception_registrations/backlink", step: @step %>
<%= form_with model: current_step,
          url: @wizard.current_step_path,
          scope: current_step_name,
          method: :patch do |f| %>
  <%= f.govuk_error_summary %>
  <%= f.govuk_radio_buttons_fieldset(:funding) do %>
    <% current_step.options.each do |option| %>
      <%= f.govuk_radio_button(:funding, option, label: { text: I18n.t("helpers.label.registration_wizard.funding_options.#{option}") }) %>
    <% end %>
  <% end %>

  <%= f.govuk_submit %>
<% end  %>
