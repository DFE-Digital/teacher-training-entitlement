<% content_for :title, t("helpers.title.registration_wizard.cannot_register_yet") %>

<%=
  render(
    'registration_wizard/shared/copy_page',
    form: @form,
    wizard: @wizard,
    ) do
%>
  <h1 class="govuk-heading-xl">You cannot register yet</h1>
  <p class="govuk-body">Registrations are currently open for courses starting in <%= @wizard.query_store.course_cohort&.name || "Registration closed" %>.</p>

  <h2 class="govuk-heading-m">Stay informed</h2>

  <p class="govuk-body">You can sign up for email updates to:</p>

  <ul class="govuk-list govuk-list--bullet">
    <li>find out when NPD registration opens</li>
  </ul>

  <%= form_for :form, url: email_updates_path do |f| %>
    <%= f.govuk_submit('Sign up for updates') %>
  <% end %>
<% end %>
