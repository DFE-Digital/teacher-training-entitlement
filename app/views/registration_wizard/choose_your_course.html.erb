<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl"><%= t("helpers.title.registration_wizard.choose_your_course") %></h1>
  </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <% t("helpers.hint.registration_wizard.choose_your_course", link: "<a href=''>learn more about the DfE CPD offering</a>").each do |line|%>
          <p class="govuk-body govuk-!-margin-bottom-7"> <%= line.html_safe %> </p>
      <% end %>
    </div>
</div>

<%=
render(
    'registration_wizard/shared/questions_page',
    form: @form,
    wizard: @wizard,
)
%>
