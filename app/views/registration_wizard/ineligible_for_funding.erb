<%=
  render(
    'registration_wizard/shared/copy_page',
    form: @form,
    wizard: @wizard,
    ) do
%>

  <%= render "registration_wizard/ineligible_for_funding/#{@form.funding_eligiblity_status_code}", course: @form.course, lead_provider: @form.lead_provider.try(:name) %>

  <%= govuk_button_link_to "Continue", registration_wizard_show_path(@wizard.next_step_path) %>

<% end %>

<% if Rails.env.development? %>
  <p>"<%= @form.funding_eligiblity_status_code %>"</p>
<% end  %>
