<% content_for :title do %><%= "Error: " if @selection.errors.any? %>Choose a course<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @selection, scope: :course_selection, url: registration_courses_path, method: :post do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_collection_radio_buttons :course_identifier,
                                           @courses,
                                           :identifier,
                                           :name,
                                           legend: { text: "Which course do you want to register for?", size: "xl", tag: "h1" } %>

      <%= f.govuk_submit "Continue" %>
    <% end %>
  </div>
</div>
