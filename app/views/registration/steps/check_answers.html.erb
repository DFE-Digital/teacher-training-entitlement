<% content_for :title, t("helpers.title.registration_wizard.check_answers") %>

<%= render "registration/steps/back_link" %>

<h1 class="govuk-heading-xl">Check your answers and submit</h1>

<%= render GovukComponent::SummaryListComponent.new do |component|
      @wizard.check_answers_rows.each do |answer|
        component.with_row do |row|
          row.with_key { answer.key }
          row.with_value { answer.value }
          if answer.change_step
            row.with_action(
              text: "Change",
              visually_hidden_text: answer.key,
              href: @wizard.resolve_step_path(answer.change_step),
            )
          end
        end
      end
    end %>

<%= form_with url: @wizard.current_step_path, method: :patch do |f| %>
  <%= f.govuk_submit "Submit" %>
<% end %>
