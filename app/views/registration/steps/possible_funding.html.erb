<% content_for :title, t("helpers.title.registration_wizard.possible_funding") %>

<%= render "registration/steps/back_link" %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Funding eligibility result</h1>

    <p class="govuk-body">You are eligible for funding.</p>

    <h2 class="govuk-heading-m">What happens next</h2>
    <ol class="govuk-list govuk-list--number">
      <li>When you submit your registration, we notify your provider that you're eligible for a funded place</li>
      <li>Your provider will contact you to complete your application and confirm if a place is available</li>
    </ol>

    <%= form_with model: @wizard.current_step, url: @wizard.current_step_path, scope: @wizard.current_step_name, method: :patch do |f| %>
      <%= f.hidden_field :funding_amount, value: Registration::Steps::StateFundedSchool::PossibleFunding::FUNDING_AMOUNT %>
      <%= f.govuk_submit %>
    <% end %>
  </div>
</div>
